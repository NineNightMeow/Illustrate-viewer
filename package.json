{
  "name": "illustrate-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Illustrate Viewer desktop image library",
  "license": "MIT",
  "repository": "https://github.com/NineNightMeow/Illustrate-viewer",
  "author": "NineNightMeow and HSP-hapy",
  "packageManager": "pnpm@10.18.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test:shortcuts": "node --experimental-strip-types --test tests/shortcut-foundation.test.mjs tests/shortcut-workflow.test.mjs",
    "test:thumbnail-scheduling": "node --test tests/thumbnail-scheduling.test.mjs",
    "test:viewer-context": "node --test tests/viewer-context.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.103.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}

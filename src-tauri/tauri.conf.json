{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Illustrate Viewer",
  "version": "0.1.0",
  "identifier": "com.illustrateviewer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Illustrate Viewer",
        "width": 1440,
        "height": 900,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local image library and viewer",
    "longDescription": "Illustrate Viewer organizes local image libraries and provides Gallery, Viewer, and Reference Window workflows.",
    "publisher": "NineNightMeow and HSP-hapy",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "../logos/logo,transparent.png",
      "icons/icon.icns",
      "../logos/logo,transparent.ico"
    ]
  }
}

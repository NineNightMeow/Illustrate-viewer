{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/NineNightMeow" },
        { "url": "https://github.com/HSP-hapy" },
        { "url": "https://github.com/NineNightMeow/Illustrate-viewer" }
      ]
    },
    "allow-app-version",
    "allow-choose-custom-background",
    "allow-prepare-custom-background",
    "allow-clear-custom-background",
    "allow-select-folder",
    "allow-create-library",
    "allow-remove-library",
    "allow-list-libraries",
    "allow-get-metadata-database-status",
    "allow-get-image-metadata",
    "allow-enqueue-metadata-tasks",
    "allow-retry-image-metadata",
    "allow-cancel-metadata-tasks",
    "allow-get-metadata-queue-status",
    "allow-get-image-color-metadata",
    "allow-analyze-image-colors",
    "allow-sample-image-color",
    "allow-get-image-fingerprint",
    "allow-analyze-image-fingerprint",
    "allow-list-duplicate-candidates",
    "allow-get-duplicate-indicators",
    "allow-add-favorite",
    "allow-remove-favorite",
    "allow-is-favorite",
    "allow-list-favorites",
    "allow-create-collection",
    "allow-delete-collection",
    "allow-rename-collection",
    "allow-list-collections",
    "allow-add-image-to-collection",
    "allow-remove-image-from-collection",
    "allow-list-collection-images",
    "allow-create-smart-collection",
    "allow-delete-smart-collection",
    "allow-rename-smart-collection",
    "allow-list-smart-collections",
    "allow-list-smart-collection-images",
    "allow-create-tag",
    "allow-delete-tag",
    "allow-rename-tag",
    "allow-list-tags",
    "allow-add-tag-to-image",
    "allow-remove-tag-from-image",
    "allow-list-image-tags",
    "allow-list-image-tags-for-images",
    "allow-list-tag-images",
    "allow-search-images",
    "allow-filter-images",
    "allow-query-image-assets",
    "allow-scan-library",
    "allow-clear-thumbnail-cache",
    "allow-prepare-image-asset",
    "allow-enqueue-thumbnail-tasks",
    "allow-sync-gallery-thumbnail-window",
    "allow-release-gallery-thumbnail-window",
    "allow-get-thumbnail-queue-status",
    "allow-cancel-thumbnail-tasks",
    "allow-open-reference-window"
  ]
}
